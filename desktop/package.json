{
  "name": "authdeck-agent-desktop",
  "productName": "AuthDeck Agent",
  "version": "0.4.1",
  "license": "FSL-1.1-MIT",
  "description": "AuthDeck Agent: lets the AuthDeck tablet and phone app control this computer.",
  "private": true,
  "main": "out/main.cjs",
  "desktopName": "authdeck-agent.desktop",
  "author": "AuthDeck",
  "homepage": "https://github.com/Sarvesh-GanesanW/authdeck",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --arm64 --x64",
    "dist:mac:local": "node scripts/build.mjs && electron-builder --mac --arm64 --x64 -c.mac.identity=\"AuthDeck Local Signing\" -c.mac.timestamp=none",
    "dist:win": "node scripts/build.mjs && electron-builder --win --x64",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --x64",
    "test": "node --experimental-strip-types --no-warnings --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "dev.authdeck.agent",
    "productName": "AuthDeck Agent",
    "copyright": "AuthDeck",
    "directories": {
      "output": "../dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/cli/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out/cli",
        "to": "cli"
      }
    ],
    "artifactName": "AuthDeck-Agent-${version}-${os}-${arch}.${ext}",
    "afterPack": "./scripts/afterPack.mjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "AuthDeck Agent uses System Events to press shortcuts and type text, and opens Terminal or iTerm to run commands from your AuthDeck keys."
      }
    },
    "dmg": {
      "title": "AuthDeck Agent ${version}"
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AuthDeck Agent"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "maintainer": "AuthDeck",
      "synopsis": "Lets the AuthDeck tablet and phone app control this computer",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "authdeck-agent",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "AuthDeck-Agent-${version}-linux-x86_64.${ext}"
    },
    "deb": {
      "artifactName": "AuthDeck-Agent-${version}-linux-amd64.${ext}"
    }
  }
}
