<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AuthDeck Agent runs with the hardened runtime and only these exceptions:
  - allow-jit: V8 (Electron's JavaScript engine) compiles code at run time.
  - automation.apple-events: the agent drives System Events (shortcuts, typing) and Terminal or
    iTerm (commands from the person's keys) through Apple Events.
  - disable-library-validation: the app's signing identities (ad hoc, and the self-signed
    "AuthDeck Local Signing") have no Team ID, and library validation refuses even Electron's own
    framework without one. Drop it once the app is signed with a Developer ID. It doesn't let
    DYLD_INSERT_LIBRARIES in: the hardened runtime ignores DYLD variables without
    allow-dyld-environment-variables, which this app never has.
  No DYLD environment variables and no unsigned executable memory.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
